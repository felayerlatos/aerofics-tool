<Window x:Class="SystemOptimizer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SystemOptimizer.App.Views"
        Title="系统优化 · 独立版" Style="{StaticResource {x:Type Window}}" Width="1360" Height="900" MinWidth="1160" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Margin="28,22,28,16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <views:SystemOptimizationView x:Name="OptimizationView" />
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ButtonBorderBrush}" Padding="0,12,0,0" Margin="0,12,0,0">
      <DockPanel LastChildFill="True">
        <Button x:Name="ElevateButton" DockPanel.Dock="Right" Content="以管理员身份重新打开" Style="{StaticResource QuietButtonStyle}" Click="Elevate_Click" Margin="18,0,0,0"/>
        <TextBlock x:Name="AccessStatus" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
