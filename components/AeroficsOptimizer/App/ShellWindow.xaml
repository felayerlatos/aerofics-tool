<Window x:Class="SystemOptimizer.App.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aerofics 性能工作台 · 2.0" Width="1440" Height="920" MinWidth="1240" MinHeight="780" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,28,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="10,0,0,28">
          <TextBlock Text="AEROFICS" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="性能工作台" FontSize="13" Margin="1,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <Border Margin="0,16,0,0" HorizontalAlignment="Left" Background="#1A2A37" CornerRadius="5" Padding="8,3"><TextBlock Text="2.0  /  WINDOWS" FontSize="10" Foreground="{DynamicResource TertiaryTextBrush}"/></Border>
        </StackPanel>
        <ListBox x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryTextBrush}"
                 ItemContainerStyle="{StaticResource NavigationItemStyle}" SelectionChanged="Navigation_Changed" SelectedIndex="0">
          <ListBoxItem Content="总览" Tag="overview"/>
          <ListBoxItem Content="进程规则" Tag="rules"/>
          <ListBoxItem Content="核心顺序" Tag="order"/>
          <ListBoxItem Content="系统设置" Tag="system"/>
          <ListBoxItem Content="Win32 调度" Tag="win32"/>
          <ListBoxItem Content="电源计划" Tag="power"/>
          <ListBoxItem Content="启动项" Tag="startup"/>
          <ListBoxItem Content="服务优化" Tag="services"/>
          <ListBoxItem Content="NVIDIA 预设" Tag="nvidia"/>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="10,12,0,0">
          <TextBlock Text="淘宝 aerofics 超频" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Text="微信 aerofics2" FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource TertiaryTextBrush}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,24,28,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource RaisedPanelBrush}" CornerRadius="16" Padding="12,6"><TextBlock x:Name="AccessStatus" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></Border>
          <Button x:Name="ElevateButton" Margin="12,0,0,0" Content="管理员模式" Style="{StaticResource QuietButtonStyle}" Click="Elevate_Click"/>
        </StackPanel>
        <StackPanel><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" FontSize="12" Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
      </DockPanel>
      <ContentControl x:Name="PageHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,18,0,0" DataContext="{Binding Scheduler}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding ModeLabel}" FontSize="13" FontWeight="SemiBold"/></StackPanel>
            <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="16,5,20,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="保存规则" Click="Save_Click" IsEnabled="{Binding CanStart}" Style="{StaticResource QuietButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="开始调度" Click="Start_Click" IsEnabled="{Binding CanStart}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="停止并恢复" Click="Stop_Click" IsEnabled="{Binding CanStop}" Style="{StaticResource QuietButtonStyle}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
