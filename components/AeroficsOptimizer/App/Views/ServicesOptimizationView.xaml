<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemOptimizer.App.Views.ServicesOptimizationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Background="#00FFFFFF" xmlns:views="clr-namespace:SystemOptimizer.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <StackPanel Margin="0,0,8,24">
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="服务优化" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="查看服务状态并修改启动方式" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新服务" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center" Command="{Binding RefreshServicesCommand}" />
      </Grid>
      <Border CornerRadius="10" Padding="15" Background="{DynamicResource AccentSurfaceBrush}" BorderBrush="{DynamicResource AccentStrongBrush}" BorderThickness="1">
        <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
          <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="先确认用途再修改。" /> <Run Text="系统、驱动、安全软件与设备服务可能存在依赖，请勿停用未知服务。" /></TextBlock>
      </Border>
      <StackPanel Margin="0,18,0,0">
        <Grid Margin="2,0,2,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="服务组" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="按实际存在的服务批量禁用；只修改启动方式，不强制终止当前运行的服务，重启后完整生效；恢复时逐项还原首次修改前的启动方式" Margin="0,5,0,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="推荐入口" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
        </Grid>
        <ItemsControl ItemsSource="{Binding ServiceGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Expander Margin="0,0,0,10" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Expander}">
                    <Border Style="{StaticResource CardStyle}">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ToggleButton HorizontalContentAlignment="Stretch" Cursor="Hand" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Title, StringFormat=展开或收起“{0}”详情}">
                            <Control.Template>
                              <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border Name="HeaderSurface" Padding="18,14" Background="#00FFFFFF" CornerRadius="11">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="12" />
                                      <ColumnDefinition Width="12" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Name="ChevronPath" Width="9" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <StackPanel Grid.Column="2">
                                      <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" />
                                        <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="8" Background="{DynamicResource AccentSurfaceBrush}">
                                          <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding RiskLabel}" />
                                        </Border>
                                      </StackPanel>
                                      <TextBlock Margin="0,5,12,0" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                                    </StackPanel>
                                  </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                                    <Setter TargetName="HeaderSurface" Value="{DynamicResource RaisedPanelBrush}" Property="Border.Background" />
                                  </Trigger>
                                  <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="ChevronPath" Property="Path.Data" Value="M0,4.5 L4.5,0 L9,4.5" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Control.Template>
                          </ToggleButton>
                          <StackPanel Grid.Column="1" Margin="8,0,16,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding StateLabel}">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                  <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Value="True" Binding="{Binding IsPartiallyDisabled}">
                                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Value="True" Binding="{Binding IsFullyDisabled}">
                                      <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                            </TextBlock>
                            <Button Content="恢复" MinHeight="36" Padding="13,7" FontSize="13" ToolTip="恢复本程序首次修改前的启动方式" ToolTipService.ShowOnDisabled="True" Style="{StaticResource QuietButtonStyle}" Margin="0,0,8,0" Command="{Binding DataContext.RestoreServiceGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" IsEnabled="{Binding CanRestore}" />
                            <Button Content="禁用" MinHeight="36" Padding="13,7" FontSize="13" ToolTip="禁用本机存在且当前未禁用的服务" ToolTipService.ShowOnDisabled="True" Style="{StaticResource DangerButtonStyle}" Command="{Binding DataContext.DisableServiceGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" IsEnabled="{Binding CanDisable}" />
                          </StackPanel>
                        </Grid>
                        <ContentPresenter Name="DetailsContent" Grid.Row="1" Margin="18,0,18,16" ContentSource="Content" Visibility="Collapsed" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="Expander.IsExpanded" Value="True">
                        <Setter TargetName="DetailsContent" Property="UIElement.Visibility" Value="Visible" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
                <Border Padding="0,14,0,0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                  <StackPanel>
                    <TextBlock Text="禁用后的影响" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,5,0,0" FontSize="12" LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding DisabledImpact}" />
                    <TextBlock Margin="0,12,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding CountLabel}" />
                    <TextBlock Text="本机检测到的相关服务" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Margin="0,5,0,0" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TertiaryTextBrush}" Text="{Binding MatchedServicesLabel}" />
                  </StackPanel>
                </Border>
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,14,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="350" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="单项服务（高级）" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="服务组未覆盖的项目可在这里逐项设置；请先确认依赖关系" Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="15" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Center">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding Services.Count, StringFormat='{}{0} 个服务'}" />
            </Border>
          </Grid>
          <DataGrid Grid.Row="2" AlternationCount="2" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="显示名称" Width="*" Binding="{Binding DisplayName}" />
              <DataGridTextColumn Header="服务名称" Width="210" Binding="{Binding Name}" />
              <DataGridTextColumn Header="运行状态" Width="120" Binding="{Binding State}" />
              <DataGridTextColumn Header="启动方式" Width="130" Binding="{Binding StartupTypeLabel}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,14,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="所选服务" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding SelectedService.DisplayName}" />
            <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}">
              <Run Text="服务名称：" /> <Run Text="{Binding SelectedService.Name}" /></TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="新的启动方式" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding ServiceStartupTypeOptions}" SelectedItem="{Binding SelectedServiceStartupType}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="恢复本次修改" Style="{StaticResource QuietButtonStyle}" Margin="0,0,8,0" Command="{Binding RestoreServiceCommand}" />
            <Button Content="应用更改" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyServiceChangeCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Margin="2,12,0,0" FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ServicesStatus}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>