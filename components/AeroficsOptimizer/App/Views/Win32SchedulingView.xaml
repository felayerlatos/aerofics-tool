<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemOptimizer.App.Views.Win32SchedulingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#00FFFFFF" xmlns:views="clr-namespace:SystemOptimizer.App.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,24">
      <Border Style="{StaticResource CardStyle}" Padding="22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Win32 前台程序调度" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Text="直接调整 Windows 系统调度设置；软件关闭后仍然有效，每个方案都可恢复到首次修改前的值。" Margin="0,6,20,0" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="刷新状态" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center" Command="{Binding RefreshWin32PriorityCommand}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="当前状态" Style="{StaticResource CardTitleStyle}" />
          <Border Margin="0,10,0,0" Padding="13" CornerRadius="8" Background="{DynamicResource AccentSurfaceBrush}">
            <TextBlock FontSize="12.5" LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding Win32PriorityStatus}" />
          </Border>
          <TextBlock Text="选择使用场景" Margin="0,20,0,8" FontSize="13" FontWeight="SemiBold" />
          <ComboBox Padding="12,9" ItemsSource="{Binding Win32PriorityPresets}" SelectedItem="{Binding SelectedWin32PriorityPreset}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid MinWidth="620">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Margin="0,3,18,0" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding BestFor}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Text="{Binding ValueLabel}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource RaisedCardStyle}" Padding="16">
              <StackPanel>
                <TextBlock Text="适合什么时候用" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Margin="0,8,0,0" LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedWin32PriorityPreset.BestFor}" />
                <TextBlock Text="能带来什么效果" Margin="0,16,0,0" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedWin32PriorityPreset.Effect}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource RaisedCardStyle}" Padding="16">
              <StackPanel>
                <TextBlock Text="可能有什么影响" Style="{StaticResource CardTitleStyle}" />
                <TextBlock Margin="0,8,0,0" LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedWin32PriorityPreset.Impact}" />
                <TextBlock Text="需要重启后完整生效。若效果不符合预期，可恢复到本程序首次修改前的设置。" Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" TextWrapping="Wrap" LineHeight="19" />
              </StackPanel>
            </Border>
          </Grid>
          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="自定义值" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
              <TextBox Width="150" Padding="10,7" Text="{Binding Win32PriorityCustomValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomWin32PriorityValue}" />
              <TextBlock Text="支持十进制 0–63 或十六进制 0x00–0x3F" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TertiaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="恢复首次修改前设置" Style="{StaticResource QuietButtonStyle}" Margin="0,0,8,0" Command="{Binding RestoreWin32PriorityCommand}" IsEnabled="{Binding HasWin32PriorityBackup}" />
              <Button Content="应用所选方案" Style="{StaticResource AccentButtonStyle}" Command="{Binding ApplyWin32PriorityCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>