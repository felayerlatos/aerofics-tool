<UserControl x:Class="SystemOptimizer.App.Views.CoreOrderView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SystemOptimizer.App.Views">
  <UserControl.Resources>
    <local:RankConverter x:Key="RankNumber"/>
    <DataTemplate x:Key="CoreTemplate"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource RankNumber}}" FontFamily="Consolas" FontSize="14" Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Processor}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
    </Grid></DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource SoftCard}" Padding="20"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><Border DockPanel.Dock="Right" Background="#163D36" CornerRadius="6" Padding="9,4"><TextBlock Text="GAME" FontSize="10" Foreground="{DynamicResource AccentBrush}"/></Border><TextBlock Text="游戏程序" FontSize="19" FontWeight="SemiBold"/></DockPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,16"><CheckBox Content="启用游戏核心顺序" IsChecked="{Binding GameCoreOrderEnabled}"/><TextBlock Text="越靠前，越优先分配给较忙的线程" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/></StackPanel>
        <ListBox x:Name="Games" Grid.Row="2" ItemsSource="{Binding GameOrder}" Style="{StaticResource CoreListStyle}" ItemContainerStyle="{StaticResource CoreItemStyle}" ItemTemplate="{StaticResource CoreTemplate}" AlternationCount="4096"/>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
          <UniformGrid Columns="4"><Button Content="上移" Tag="game:up" Click="Move_Click" Margin="0,0,6,8"/><Button Content="下移" Tag="game:down" Click="Move_Click" Margin="0,0,6,8"/><Button Content="置顶" Tag="game:top" Click="Move_Click" Margin="0,0,6,8"/><Button Content="置底" Tag="game:bottom" Click="Move_Click" Margin="0,0,0,8"/></UniformGrid>
          <UniformGrid Columns="4"><Button Content="L3 正序" Tag="game:l3" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8" Margin="0,0,6,0"/><Button Content="L3 逆序" Tag="game:l3-reverse" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8" Margin="0,0,6,0"/><Button Content="物理核优先" Tag="game:physical" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8" Margin="0,0,6,0"/><Button Content="反转" Tag="game:reverse" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8"/></UniformGrid>
        </StackPanel>
      </Grid></Border>
      <Border Grid.Column="2" Style="{StaticResource SoftCard}" Padding="20"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><Border DockPanel.Dock="Right" Background="#29344E" CornerRadius="6" Padding="9,4"><TextBlock Text="BACKGROUND" FontSize="10" Foreground="#A7BDEF"/></Border><TextBlock Text="非游戏程序" FontSize="19" FontWeight="SemiBold"/></DockPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,16"><CheckBox Content="启用非游戏核心顺序" IsChecked="{Binding BackgroundCoreOrderEnabled}"/><TextBlock Text="作用于进程规则中的非游戏程序列表" Style="{StaticResource CaptionTextStyle}" Margin="0,8,0,0"/></StackPanel>
        <ListBox x:Name="Backgrounds" Grid.Row="2" ItemsSource="{Binding BackgroundOrder}" Style="{StaticResource CoreListStyle}" ItemContainerStyle="{StaticResource CoreItemStyle}" ItemTemplate="{StaticResource CoreTemplate}" AlternationCount="4096"/>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
          <UniformGrid Columns="4"><Button Content="上移" Tag="background:up" Click="Move_Click" Margin="0,0,6,8"/><Button Content="下移" Tag="background:down" Click="Move_Click" Margin="0,0,6,8"/><Button Content="置顶" Tag="background:top" Click="Move_Click" Margin="0,0,6,8"/><Button Content="置底" Tag="background:bottom" Click="Move_Click" Margin="0,0,0,8"/></UniformGrid>
          <UniformGrid Columns="4"><Button Content="L3 正序" Tag="background:l3" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8" Margin="0,0,6,0"/><Button Content="L3 逆序" Tag="background:l3-reverse" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8" Margin="0,0,6,0"/><Button Content="物理核优先" Tag="background:physical" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8" Margin="0,0,6,0"/><Button Content="反转" Tag="background:reverse" Click="Preset_Click" Style="{StaticResource QuietButtonStyle}" Padding="4,8"/></UniformGrid>
        </StackPanel>
      </Grid></Border>
    </Grid>
    <Border Grid.Row="1" Background="#121F2A" CornerRadius="9" Padding="16,12" Margin="0,16,0,0"><TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20"
      Text="两套顺序独立生效，Windows 仍可使用其他可用核心。启用后替代对应程序的核心范围设置。&#10;每秒跟随线程负载与新线程；保留程序已有的亲和性约束。L3 编号不自动区分缓存核与频率核。"/></Border>
  </Grid>
</UserControl>
