<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="SystemOptimizer.App.Views.StartupItemsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#00FFFFFF" xmlns:views="clr-namespace:SystemOptimizer.App.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="CenteredStartupHeaderStyle" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <StackPanel Margin="0,0,8,24">
      <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="启动项" FontSize="26" FontWeight="Bold" />
          <TextBlock Text="管理注册表中的 Windows 登录启动项" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新列表" Style="{StaticResource QuietButtonStyle}" VerticalAlignment="Center" Command="{Binding RefreshStartupItemsCommand}" />
      </Grid>
      <Border Style="{StaticResource CardStyle}" Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="420" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="注册表登录启动项" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="覆盖当前用户 Run 项和所有用户的 64/32 位 Run 项；不包含计划任务和“启动”文件夹" Margin="0,5,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,6" CornerRadius="15" Background="{DynamicResource AccentSurfaceBrush}" VerticalAlignment="Center">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding StartupItems.Count, StringFormat='{}{0} 个项目'}" />
            </Border>
          </Grid>
          <DataGrid Grid.Row="2" AlternationCount="2" CanUserResizeColumns="False" CanUserReorderColumns="False" ClipToBounds="True" ItemsSource="{Binding StartupItems}">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="名称" Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Name}" ToolTip="{Binding Name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="来源" Width="175">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SourceLabel}" ToolTip="{Binding Location}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="启动命令" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding Command}" ToolTip="{Binding Command}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="状态" Width="96" HeaderStyle="{StaticResource CenteredStartupHeaderStyle}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Padding="9,4" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Border}">
                          <Setter Property="Background" Value="{DynamicResource RaisedPanelBrush}" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsEnabled}">
                              <Setter Property="Background" Value="{DynamicResource AccentSurfaceBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                      <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding State}">
                        <FrameworkElement.Style>
                          <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Style.Triggers>
                              <DataTrigger Value="True" Binding="{Binding IsEnabled}">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </FrameworkElement.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="操作" Width="162" HeaderStyle="{StaticResource CenteredStartupHeaderStyle}">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button MinWidth="62" MinHeight="34" Padding="10,6" FontSize="13" Style="{StaticResource QuietButtonStyle}" Margin="0,0,6,0" Content="{Binding ActionLabel}" Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                      <Button Content="恢复" MinWidth="62" MinHeight="34" Padding="10,6" FontSize="13" ToolTip="恢复本程序首次修改前的状态" ToolTipService.ShowOnDisabled="True" Style="{StaticResource QuietButtonStyle}" Command="{Binding DataContext.RestoreStartupItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" IsEnabled="{Binding HasRecovery}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <TextBlock Margin="2,10,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StartupItemsStatus}" />
      <Border Margin="0,14,0,0" Padding="15,13" CornerRadius="9" Background="{DynamicResource RaisedPanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}">
          <Run FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="实际效果：" /> <Run Text="停用后 Windows 下次登录不会从对应 Run 项启动该程序；原命令和值类型会先保存并在写入后回读确认。软件自身仍可能重新创建启动项，显卡、触控板、安全软件与音频驱动项目请谨慎停用。" /></TextBlock>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>